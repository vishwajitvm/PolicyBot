                <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#3b82f6;" parent="1" source="users" target="nginx" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
