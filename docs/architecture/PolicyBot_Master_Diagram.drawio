    <diagram id="page2_ingestion" name="2. Document Ingestion Pipeline">
        <mxGraphModel dx="1524" dy="801" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="p2" parent="0"/>
                <mxCell id="ing_title" value="LangGraph Document Ingestion State Machine (langgraph_workflow.py)&#xa;A compiled StateGraph that processes documents through Load → Chunk → Embed with conditional error routing." style="swimlane;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontStyle=1;fontSize=13;" parent="p2" vertex="1">
                    <mxGeometry x="40" y="40" width="1900" height="800" as="geometry"/>
                </mxCell>
                <mxCell id="i_src" value="Source Connector&#xa;(Local Folder / Google Drive)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;fontStyle=1;" parent="ing_title" vertex="1">
                    <mxGeometry x="30" y="120" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_src_desc" value="Scans filesystem or calls Google Drive API&#xa;to discover new/updated files. Triggers&#xa;ingestion_service.py which creates an&#xa;IngestionJob in MongoDB." style="text;html=1;fontSize=10;align=left;" parent="ing_title" vertex="1">
                    <mxGeometry x="30" y="200" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="i_cancel" value="Cancellation Check&#xa;(cancellation.py)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;" parent="ing_title" vertex="1">
                    <mxGeometry x="260" y="70" width="130" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="i_cancel_desc" value="Before each node, checks if user&#xa;cancelled the job via asyncio.Event.&#xa;Raises CancelledError to abort." style="text;html=1;fontSize=10;align=left;" parent="ing_title" vertex="1">
                    <mxGeometry x="240" y="140" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i_load" value="LOAD NODE&#xa;(load_document_node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" parent="ing_title" vertex="1">
                    <mxGeometry x="440" y="100" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="i_load_desc" value="Uses LangChain UnstructuredFileLoader&#xa;to parse any file type:&#xa;PDF, DOCX, XLSX, TXT, MD, images.&#xa;Returns LangChain Document objects." style="text;html=1;fontSize=10;align=left;" parent="ing_title" vertex="1">
                    <mxGeometry x="420" y="170" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_cond1" value="Error?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#eab308;" parent="ing_title" vertex="1">
                    <mxGeometry x="660" y="100" width="80" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="i_end1" value="END&#xa;(Error State)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;" parent="ing_title" vertex="1">
                    <mxGeometry x="660" y="250" width="80" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i_chunk" value="CHUNK NODE&#xa;(chunk_document_node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontStyle=1;" parent="ing_title" vertex="1">
                    <mxGeometry x="800" y="100" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="i_chunk_desc" value="LangChain RecursiveCharacterTextSplitter&#xa;chunk_size=1000, overlap=100&#xa;Separators: \\n\\n → \\n → space → char&#xa;Produces semantically coherent segments." style="text;html=1;fontSize=10;align=left;" parent="ing_title" vertex="1">
                    <mxGeometry x="780" y="170" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_cond2" value="Error?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#eab308;" parent="ing_title" vertex="1">
                    <mxGeometry x="1030" y="100" width="80" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="i_embed" value="EMBED &amp; INDEX NODE&#xa;(EmbedNodeFactory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontStyle=1;" parent="ing_title" vertex="1">
                    <mxGeometry x="1170" y="100" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="i_embed_desc" value="1. Batches chunks (batch_size=50)&#xa;2. Calls EmbeddingProvider.embed_texts()&#xa;   (Fallback chain: Gemini→OpenAI→Ollama)&#xa;3. Creates VectorChunk with UUID&#xa;4. Upserts into Qdrant via vector_store&#xa;5. Logs progress via WebSocket" style="text;html=1;fontSize=10;align=left;" parent="ing_title" vertex="1">
                    <mxGeometry x="1150" y="170" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="i_qdrant" value="Qdrant&#xa;Vector Store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" parent="ing_title" vertex="1">
                    <mxGeometry x="1440" y="80" width="100" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_mongo_state" value="MongoDB&#xa;(Job State &amp; Docs)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dbeafe;strokeColor=#3b82f6;fontStyle=1;" parent="ing_title" vertex="1">
                    <mxGeometry x="1440" y="200" width="100" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_ws" value="WebSocket&#xa;(Live Progress)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#ec4899;" parent="ing_title" vertex="1">
                    <mxGeometry x="1600" y="120" width="100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="i_state_box" value="IngestionState (TypedDict):&#xa;job_id, file_path, file_name, source_id, document_id,&#xa;chunks[], embedded_vectors[], error, logs[] (append-only),&#xa;total_documents, processed_documents, embedded_chunks_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=10;align=left;spacingLeft=8;" parent="ing_title" vertex="1">
                    <mxGeometry x="400" y="350" width="500" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ie1" style="strokeWidth=2;" parent="ing_title" source="i_src" target="i_cancel" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie2" style="strokeWidth=2;" parent="ing_title" source="i_cancel" target="i_load" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie3" style="strokeWidth=2;" parent="ing_title" source="i_load" target="i_cond1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie4" value="Yes" style="strokeWidth=2;strokeColor=#ef4444;" parent="ing_title" source="i_cond1" target="i_end1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie5" value="No" style="strokeWidth=2;strokeColor=#22c55e;" parent="ing_title" source="i_cond1" target="i_chunk" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie6" style="strokeWidth=2;" parent="ing_title" source="i_chunk" target="i_cond2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie7" value="No" style="strokeWidth=2;strokeColor=#22c55e;" parent="ing_title" source="i_cond2" target="i_embed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie8" style="strokeWidth=2;strokeColor=#22c55e;" parent="ing_title" source="i_embed" target="i_qdrant" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie9" style="strokeWidth=2;strokeColor=#3b82f6;" parent="ing_title" source="i_embed" target="i_mongo_state" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie10" style="strokeWidth=2;dashed=1;strokeColor=#ec4899;" parent="ing_title" source="i_embed" target="i_ws" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page3_rag" name="3. RAG Query Pipeline">
        <mxGraphModel dx="3524" dy="1801" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="p3" parent="0"/>
                <mxCell id="rag_title" value="LangGraph RAG Execution Pipeline (rag_graph.py)&#xa;17-node state machine: query → normalize → classify → embed → retrieve → merge → rerank → grade → prompt → generate → cite → score → persist → respond" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontStyle=1;fontSize=13;" parent="p3" vertex="1">
                    <mxGeometry x="40" y="40" width="1900" height="880" as="geometry"/>
                </mxCell>
                <mxCell id="r_query" value="User Query" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="20" y="100" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_norm" value="Normalize&#xa;(whitespace strip)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;" parent="rag_title" vertex="1">
                    <mxGeometry x="170" y="100" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_intent" value="Classify Intent&#xa;(policy_qa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;" parent="rag_title" vertex="1">
                    <mxGeometry x="330" y="100" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_variants" value="Generate Variants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;" parent="rag_title" vertex="1">
                    <mxGeometry x="490" y="100" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_embed" value="Embed Query&#xa;(EmbeddingProvider)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="20" y="250" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_embed_desc" value="Calls FallbackEmbeddingProvider.embed_query()&#xa;Converts query text → 768-dim vector" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="20" y="310" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r_vec_search" value="Vector Search&#xa;(Qdrant Semantic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="220" y="250" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_vec_desc" value="Cosine similarity search in Qdrant&#xa;top_k=8 nearest neighbors" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="220" y="310" width="170" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r_kw_search" value="Keyword Search&#xa;(MongoDB $text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="420" y="250" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_kw_desc" value="Full-text search on chunks collection&#xa;BM25-style keyword matching" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="420" y="310" width="170" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r_merge" value="Merge Candidates&#xa;(Deduplicate by chunk_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#eab308;" parent="rag_title" vertex="1">
                    <mxGeometry x="620" y="250" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_rerank" value="Re-Ranker&#xa;(reranker.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="830" y="250" width="130" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_rerank_desc" value="Sorts by score, takes rerank_top_k=5" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="830" y="310" width="180" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="r_fresh" value="Freshness Resolver&#xa;(freshness_resolver.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#ec4899;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="1010" y="250" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_fresh_desc" value="Checks document dates for staleness.&#xa;Filters outdated chunks if newer exist." style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="1010" y="310" width="190" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r_grade" value="Context Grader&#xa;(context_grader.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="1220" y="250" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_grade_desc" value="Scores context relevance (0-1)&#xa;based on query-chunk alignment" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="1220" y="310" width="170" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r_prompt" value="Prompt Builder&#xa;(prompt_builder.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="20" y="450" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_prompt_desc" value="Assembles system prompt with&#xa;retrieved context chunks injected" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="20" y="510" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r_llm" value="LLM Answer Generator&#xa;(FallbackLLMProvider)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="230" y="450" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_llm_desc" value="Sends prompt to primary LLM.&#xa;On failure, falls to next provider.&#xa;Logs tokens/latency to MetricsService." style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="230" y="510" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r_cite" value="Citation Generator&#xa;(citation_service.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="460" y="450" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_cite_desc" value="Builds citation objects from chunks.&#xa;Validates citation quality score." style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="460" y="510" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r_score" value="Confidence Scorer&#xa;(scoring_service.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#eab308;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="670" y="450" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_score_desc" value="Weighted composite score:&#xa;retrieval(35%) + freshness(20%)&#xa;+ context_relevance(25%)&#xa;+ citation_quality(20%)" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="670" y="510" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r_trace" value="Trace Persister&#xa;(TraceService → MongoDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="880" y="450" width="170" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_trace_desc" value="Records all 17 events to traces collection.&#xa;Each event: step, status, input/output summary" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="880" y="510" width="230" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r_resp" value="QueryResponse&#xa;(JSON to Client)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" parent="rag_title" vertex="1">
                    <mxGeometry x="1100" y="450" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_resp_desc" value="answer, citations[], scores{},&#xa;trace_id, session_id, model,&#xa;embedding_model, vector_db, latency_ms" style="text;html=1;fontSize=10;align=left;" parent="rag_title" vertex="1">
                    <mxGeometry x="1080" y="510" width="190" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="re1" style="strokeWidth=2;" parent="rag_title" source="r_query" target="r_norm" edge="1"/>
                <mxCell id="re2" style="strokeWidth=2;" parent="rag_title" source="r_norm" target="r_intent" edge="1"/>
                <mxCell id="re3" style="strokeWidth=2;" parent="rag_title" source="r_intent" target="r_variants" edge="1"/>
                <mxCell id="re4" style="strokeWidth=2;" parent="rag_title" source="r_variants" target="r_embed" edge="1"/>
                <mxCell id="re5" style="strokeWidth=2;" parent="rag_title" source="r_embed" target="r_vec_search" edge="1"/>
                <mxCell id="re6" style="strokeWidth=2;" parent="rag_title" source="r_embed" target="r_kw_search" edge="1"/>
                <mxCell id="re7" style="strokeWidth=2;" parent="rag_title" source="r_vec_search" target="r_merge" edge="1"/>
                <mxCell id="re8" style="strokeWidth=2;" parent="rag_title" source="r_kw_search" target="r_merge" edge="1"/>
                <mxCell id="re9" style="strokeWidth=2;" parent="rag_title" source="r_merge" target="r_rerank" edge="1"/>
                <mxCell id="re10" style="strokeWidth=2;" parent="rag_title" source="r_rerank" target="r_fresh" edge="1"/>
                <mxCell id="re11" style="strokeWidth=2;" parent="rag_title" source="r_fresh" target="r_grade" edge="1"/>
                <mxCell id="re12" style="strokeWidth=2;" parent="rag_title" source="r_grade" target="r_prompt" edge="1"/>
                <mxCell id="re13" style="strokeWidth=2;" parent="rag_title" source="r_prompt" target="r_llm" edge="1"/>
                <mxCell id="re14" style="strokeWidth=2;" parent="rag_title" source="r_llm" target="r_cite" edge="1"/>
                <mxCell id="re15" style="strokeWidth=2;" parent="rag_title" source="r_cite" target="r_score" edge="1"/>
                <mxCell id="re16" style="strokeWidth=2;" parent="rag_title" source="r_score" target="r_trace" edge="1"/>
                <mxCell id="re17" style="strokeWidth=2;" parent="rag_title" source="r_trace" target="r_resp" edge="1"/>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page4_llm" name="4. LLM Orchestration &amp; Fallback">
        <mxGraphModel dx="3124" dy="1701" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="p4" parent="0"/>
                <mxCell id="llm_title" value="LLM Provider Orchestration &amp; Fallback Chain (provider_factory.py + fallback_provider.py)&#xa;Dynamically builds a chain of LLM providers from .env config. On failure, automatically retries the next provider." style="swimlane;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;fontStyle=1;fontSize=13;" parent="p4" vertex="1">
                    <mxGeometry x="40" y="40" width="1520" height="800" as="geometry"/>
                </mxCell>
                <mxCell id="lf_env" value=".env Configuration&#xa;LLM_FALLBACK_PROVIDERS=gemini,openai,groq&#xa;EMBEDDING_FALLBACK_PROVIDERS=gemini,ollama" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=11;align=left;spacingLeft=10;" parent="llm_title" vertex="1">
                    <mxGeometry x="30" y="80" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="lf_factory" value="ProviderFactory&#xa;(provider_factory.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#eab308;fontStyle=1;" parent="llm_title" vertex="1">
                    <mxGeometry x="400" y="80" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="lf_factory_desc" value="1. Reads LLM_FALLBACK_PROVIDERS from Settings&#xa;2. Instantiates each provider class&#xa;3. If multiple, wraps in FallbackLLMProvider&#xa;4. If single, returns direct provider instance" style="text;html=1;fontSize=10;align=left;" parent="llm_title" vertex="1">
                    <mxGeometry x="380" y="150" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="lf_chain" value="FallbackLLMProvider&#xa;(fallback_provider.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontStyle=1;" parent="llm_title" vertex="1">
                    <mxGeometry x="700" y="80" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="lf_p1" value="Provider 1: GeminiProvider&#xa;(Primary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;" parent="llm_title" vertex="1">
                    <mxGeometry x="200" y="300" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lf_p2" value="Provider 2: OpenAIProvider&#xa;(Fallback 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;" parent="llm_title" vertex="1">
                    <mxGeometry x="450" y="300" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lf_p3" value="Provider 3: GroqProvider&#xa;(Fallback 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;" parent="llm_title" vertex="1">
                    <mxGeometry x="700" y="300" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lf_pn" value="Provider N...&#xa;(DeepSeek/Mistral/NVIDIA/HF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;" parent="llm_title" vertex="1">
                    <mxGeometry x="950" y="300" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lf_metrics" value="MetricsService.log_usage()&#xa;(Async fire-and-forget)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#eab308;" parent="llm_title" vertex="1">
                    <mxGeometry x="450" y="450" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lf_metrics_desc" value="On EVERY call (success or failure):&#xa;Logs provider, model, input_tokens,&#xa;output_tokens, latency_ms, success&#xa;→ MongoDB llm_metrics collection" style="text;html=1;fontSize=10;align=left;" parent="llm_title" vertex="1">
                    <mxGeometry x="430" y="510" width="230" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="lf_success" value="Success!&#xa;Return LLMResponse" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;" parent="llm_title" vertex="1">
                    <mxGeometry x="250" y="450" width="130" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lf_fail" value="All Failed!&#xa;Raise Exception" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;" parent="llm_title" vertex="1">
                    <mxGeometry x="750" y="450" width="130" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="le1" style="strokeWidth=2;" parent="llm_title" source="lf_env" target="lf_factory" edge="1"/>
                <mxCell id="le2" style="strokeWidth=2;" parent="llm_title" source="lf_factory" target="lf_chain" edge="1"/>
                <mxCell id="le3" value="Try first" style="strokeWidth=2;strokeColor=#ef4444;" parent="llm_title" source="lf_chain" target="lf_p1" edge="1"/>
                <mxCell id="le4" value="On fail, try next" style="strokeWidth=2;dashed=1;strokeColor=#f59e0b;" parent="llm_title" source="lf_p1" target="lf_p2" edge="1"/>
                <mxCell id="le5" value="On fail, try next" style="strokeWidth=2;dashed=1;strokeColor=#f59e0b;" parent="llm_title" source="lf_p2" target="lf_p3" edge="1"/>
                <mxCell id="le6" value="On fail, try next" style="strokeWidth=2;dashed=1;strokeColor=#f59e0b;" parent="llm_title" source="lf_p3" target="lf_pn" edge="1"/>
                <mxCell id="le7" value="On success" style="strokeWidth=2;strokeColor=#22c55e;" parent="llm_title" source="lf_p1" target="lf_success" edge="1"/>
                <mxCell id="le8" value="All exhausted" style="strokeWidth=2;strokeColor=#ef4444;" parent="llm_title" source="lf_pn" target="lf_fail" edge="1"/>
                <mxCell id="le9" style="strokeWidth=1;dashed=1;" parent="llm_title" source="lf_p1" target="lf_metrics" edge="1"/>
                <mxCell id="le10" style="strokeWidth=1;dashed=1;" parent="llm_title" source="lf_p2" target="lf_metrics" edge="1"/>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page5_eval" name="5. AI Judge &amp; Evaluation">
        <mxGraphModel dx="3124" dy="2401" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="p5" parent="0"/>
                <mxCell id="eval_title" value="Golden Dataset Evaluation &amp; AI Judge Pipeline (eval_service.py)&#xa;For each item in a golden dataset: runs full RAG pipeline, then LLM Judge grades the output against expected answer." style="swimlane;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#ec4899;fontStyle=1;fontSize=13;" parent="p5" vertex="1">
                    <mxGeometry x="40" y="40" width="1520" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="ev_dataset" value="Golden Dataset&#xa;(eval_datasets collection)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dbeafe;strokeColor=#3b82f6;fontStyle=1;" parent="eval_title" vertex="1">
                    <mxGeometry x="30" y="100" width="150" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ev_dataset_desc" value="Contains items[]: each with&#xa;question + expected_answer" style="text;html=1;fontSize=10;align=left;" parent="eval_title" vertex="1">
                    <mxGeometry x="30" y="190" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ev_loop" value="FOR EACH ITEM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#eab308;fontStyle=1;" parent="eval_title" vertex="1">
                    <mxGeometry x="250" y="120" width="130" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ev_rag" value="Full RAG Pipeline&#xa;(rag_graph.run(question))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontStyle=1;" parent="eval_title" vertex="1">
                    <mxGeometry x="440" y="100" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ev_rag_desc" value="Executes the complete 17-node&#xa;RAG pipeline from Page 3.&#xa;Returns generated_answer + trace_id" style="text;html=1;fontSize=10;align=left;" parent="eval_title" vertex="1">
                    <mxGeometry x="430" y="170" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ev_judge" value="LLM Judge&#xa;(AI Grading via FallbackLLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontStyle=1;" parent="eval_title" vertex="1">
                    <mxGeometry x="700" y="100" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ev_judge_desc" value="Prompt: &quot;You are an expert AI judge...&quot;&#xa;Compares GENERATED vs EXPECTED.&#xa;Returns JSON: {passed: bool, reason: string}&#xa;temperature=0.1 for deterministic grading" style="text;html=1;fontSize=10;align=left;" parent="eval_title" vertex="1">
                    <mxGeometry x="680" y="170" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ev_accuracy" value="AccuracyService&#xa;(accuracy_service.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;" parent="eval_title" vertex="1">
                    <mxGeometry x="980" y="100" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ev_accuracy_desc" value="Computes pass/fail counts&#xa;and accuracy percentage" style="text;html=1;fontSize=10;align=left;" parent="eval_title" vertex="1">
                    <mxGeometry x="980" y="170" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ev_store" value="eval_runs&#xa;(MongoDB)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dbeafe;strokeColor=#3b82f6;" parent="eval_title" vertex="1">
                    <mxGeometry x="1220" y="90" width="120" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ev_store_desc" value="Stores: run_id, dataset_id,&#xa;accuracy, passed, failed,&#xa;details[] with trace per item" style="text;html=1;fontSize=10;align=left;" parent="eval_title" vertex="1">
                    <mxGeometry x="1200" y="170" width="170" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ee1" style="strokeWidth=2;" parent="eval_title" source="ev_dataset" target="ev_loop" edge="1"/>
                <mxCell id="ee2" style="strokeWidth=2;" parent="eval_title" source="ev_loop" target="ev_rag" edge="1"/>
                <mxCell id="ee3" style="strokeWidth=2;" parent="eval_title" source="ev_rag" target="ev_judge" edge="1"/>
                <mxCell id="ee4" style="strokeWidth=2;" parent="eval_title" source="ev_judge" target="ev_accuracy" edge="1"/>
                <mxCell id="ee5" style="strokeWidth=2;" parent="eval_title" source="ev_accuracy" target="ev_store" edge="1"/>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page6_obs" name="6. Observability &amp; Security">
        <mxGraphModel dx="3124" dy="1701" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="p6" parent="0"/>
                <mxCell id="obs_zone" value="Observability &amp; Tracing Stack" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontStyle=1;fontSize=13;" parent="p6" vertex="1">
                    <mxGeometry x="40" y="40" width="1520" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="obs_tracenest" value="TraceNest Logger&#xa;(tracenest library)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontStyle=1;" parent="obs_zone" vertex="1">
                    <mxGeometry x="30" y="60" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="obs_tracenest_desc" value="Structured JSON logging.&#xa;Replaces standard Python logging.&#xa;Includes tracenest UI router." style="text;html=1;fontSize=10;align=left;" parent="obs_zone" vertex="1">
                    <mxGeometry x="30" y="120" width="180" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="obs_trace_svc" value="TraceService&#xa;(trace_service.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" parent="obs_zone" vertex="1">
                    <mxGeometry x="260" y="60" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="obs_trace_desc" value="Per-query trace: records 17 events&#xa;(step name, status, input/output).&#xa;Persists to traces collection." style="text;html=1;fontSize=10;align=left;" parent="obs_zone" vertex="1">
                    <mxGeometry x="260" y="120" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="obs_metrics_svc" value="MetricsService&#xa;(metrics_service.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontStyle=1;" parent="obs_zone" vertex="1">
                    <mxGeometry x="500" y="60" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="obs_metrics_desc" value="Aggregation pipelines per provider/model.&#xa;Timeseries: daily requests/tokens/error rates.&#xa;Powers the Dashboard analytics." style="text;html=1;fontSize=10;align=left;" parent="obs_zone" vertex="1">
                    <mxGeometry x="490" y="120" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="obs_log_store" value="LogStore&#xa;(log_store.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;fontStyle=1;" parent="obs_zone" vertex="1">
                    <mxGeometry x="740" y="60" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="obs_log_desc" value="Structured log persistence.&#xa;Queryable via /api/v1/logs endpoint.&#xa;Max 10MB rotating log file." style="text;html=1;fontSize=10;align=left;" parent="obs_zone" vertex="1">
                    <mxGeometry x="730" y="120" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="obs_log_event" value="log_event()&#xa;(log_event.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#ec4899;" parent="obs_zone" vertex="1">
                    <mxGeometry x="950" y="60" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="obs_db" value="MongoDB Collections:&#xa;traces, llm_metrics, policybot_logs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dbeafe;strokeColor=#3b82f6;" parent="obs_zone" vertex="1">
                    <mxGeometry x="1150" y="60" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="oe1" style="strokeWidth=2;" parent="obs_zone" source="obs_tracenest" target="obs_trace_svc" edge="1"/>
                <mxCell id="oe2" style="strokeWidth=2;" parent="obs_zone" source="obs_trace_svc" target="obs_db" edge="1"/>
                <mxCell id="oe3" style="strokeWidth=2;" parent="obs_zone" source="obs_metrics_svc" target="obs_db" edge="1"/>
                <mxCell id="oe4" style="strokeWidth=2;" parent="obs_zone" source="obs_log_store" target="obs_db" edge="1"/>
                <mxCell id="sec_zone" value="Security Architecture &amp; Defense Layers" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontStyle=1;fontSize=13;" parent="p6" vertex="1">
                    <mxGeometry x="40" y="430" width="1520" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l1" value="Layer 1: Network Isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontStyle=1;" parent="sec_zone" vertex="1">
                    <mxGeometry x="30" y="50" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l1_desc" value="• Docker bridge network isolates all containers&#xa;• Only Nginx exposes ports 80/443 externally&#xa;• Backend (:8000), MongoDB (:27017), Qdrant (:6333),&#xa;  Redis (:6379) are internal-only&#xa;• No direct database access from outside" style="text;html=1;fontSize=10;align=left;" parent="sec_zone" vertex="1">
                    <mxGeometry x="30" y="90" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l2" value="Layer 2: Reverse Proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontStyle=1;" parent="sec_zone" vertex="1">
                    <mxGeometry x="370" y="50" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l2_desc" value="• Nginx terminates SSL/TLS&#xa;• Injects X-Real-IP, X-Forwarded-For headers&#xa;• Rate limiting configurable per location&#xa;• Only / and /api/ routes exposed&#xa;• All other paths return 404" style="text;html=1;fontSize=10;align=left;" parent="sec_zone" vertex="1">
                    <mxGeometry x="370" y="90" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l3" value="Layer 3: Application Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#eab308;fontStyle=1;" parent="sec_zone" vertex="1">
                    <mxGeometry x="680" y="50" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l3_desc" value="• CORS whitelist (only allowed origins)&#xa;• Pydantic input validation on all endpoints&#xa;• Custom exception handlers (no stack traces)&#xa;• API key masking (mask_secret)&#xa;• Structured error responses (code + message)&#xa;• HTTP method restrictions per route" style="text;html=1;fontSize=10;align=left;" parent="sec_zone" vertex="1">
                    <mxGeometry x="680" y="90" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l4" value="Layer 4: Data &amp; Secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" parent="sec_zone" vertex="1">
                    <mxGeometry x="1010" y="50" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l4_desc" value="• All API keys in .env (not in code)&#xa;• .env excluded from Git (.gitignore)&#xa;• Docker volumes for persistent data&#xa;• Non-root container execution&#xa;• Pydantic Settings with env_file&#xa;• Google OAuth2 with scoped permissions" style="text;html=1;fontSize=10;align=left;" parent="sec_zone" vertex="1">
                    <mxGeometry x="1010" y="90" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l5" value="Layer 5: Runtime Protection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontStyle=1;" parent="sec_zone" vertex="1">
                    <mxGeometry x="30" y="230" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l5_desc" value="• Global unhandled exception handler&#xa;• Graceful degradation (MongoDB optional)&#xa;• Fallback LLM chain (no single point of failure)&#xa;• Async task cancellation for ingestion jobs&#xa;• Dead WebSocket connection cleanup&#xa;• Rotating log files (10MB max)" style="text;html=1;fontSize=10;align=left;" parent="sec_zone" vertex="1">
                    <mxGeometry x="30" y="270" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l6" value="Layer 6: Attack Prevention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;fontStyle=1;" parent="sec_zone" vertex="1">
                    <mxGeometry x="370" y="230" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sec_l6_desc" value="• CORS blocks cross-origin requests&#xa;• Input sanitization via Pydantic schemas&#xa;• No raw SQL (MongoDB with Motor)&#xa;• No file path traversal (controlled uploads)&#xa;• JSON-only API responses (no HTML injection)&#xa;• Container isolation prevents lateral movement" style="text;html=1;fontSize=10;align=left;" parent="sec_zone" vertex="1">
                    <mxGeometry x="370" y="270" width="280" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>