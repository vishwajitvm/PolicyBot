                <mxCell id="google_apis" value="Google Cloud APIs" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1440" y="740" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="gdrive_api" value="Google Drive API (OAuth2)&#xa;File listing, download, sync" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" parent="google_apis" vertex="1">
                    <mxGeometry x="20" y="40" width="200" height="50" as="geometry"/>
