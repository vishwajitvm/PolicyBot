                <mxCell id="e2" value="Static Files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#22c55e;" parent="1" source="nginx" target="fe" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="REST /api/v1/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#f97316;" parent="1" source="nginx" target="be" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="Axios/Fetch API Calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;dashed=1;strokeColor=#6366f1;" parent="1" source="fe" target="be" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="Motor AsyncIO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#3b82f6;" parent="1" source="be" target="db_mongo" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
